{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SESAssumeRole",
      "Effect": "Allow",
      "Principal": {
        "Service": "ses.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": "REPLACE_ACCOUNT_ID"
        }
      }
    }
  ]
}
